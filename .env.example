# Local environment template (safe to commit)
#
# Workflow (Windows PowerShell):
#   Copy-Item .env.example .env
# POSIX:
#   cp .env.example .env
#
# Fill values for dedicated DEVELOPMENT infrastructure only.
# Never commit .env. Never use production PostgreSQL or Redis here.
# Full reference: instructions/environment.md
#
# NODE_ENV — required, not secret. One of: development | test | production
# (Staging is a deployment tier, not a NODE_ENV value.)
NODE_ENV=

# PORT — required, not secret. HTTP listen port 1–65535
PORT=

# DATABASE_URL — required, secret. postgresql:// or postgres://
# Prefer a remote dedicated development database. Do not invent real credentials in git.
DATABASE_URL=

# PostgreSQL pool settings — optional, not secret. Defaults: 10 / 5000ms / 30000ms.
# Budget DATABASE_POOL_MAX across every API and worker replica; allowed range 1–50.
DATABASE_POOL_MAX=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_IDLE_TIMEOUT_MS=

# APP_VERSION — required, not secret. Semantic version for logs/health/OpenAPI
# Local example: 0.1.0 (must be valid SemVer). Deployments inject the release version.
APP_VERSION=

# GIT_SHA — required, not secret. Source revision metadata for logs
# Local example: local. Deployments inject the build commit SHA automatically.
GIT_SHA=

# REDIS_URL — optional, secret. redis:// or rediss://
# Leave blank to start without Redis. If set, use development Redis only—never production.
REDIS_URL=

# Worker process (required only for `pnpm worker`; worker refuses to start without Redis)
# WORKER_CONCURRENCY — optional bounded per-process BullMQ concurrency (default 5, range 1–100)
WORKER_CONCURRENCY=
# WORKER_SHUTDOWN_TIMEOUT_MS — optional graceful drain bound (default 30000, range 1000–300000)
WORKER_SHUTDOWN_TIMEOUT_MS=

# OPENAPI_ENABLED — optional, not secret. true | false override for /docs exposure
OPENAPI_ENABLED=

# JWT_ACCESS_SECRET — required, secret. HS256 signing key for access tokens (>= 32 chars, non-trivial)
# Local example only — never reuse in production. Do not commit real secrets.
JWT_ACCESS_SECRET=

# JWT_ACCESS_TTL — optional, not secret. Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL=

# REFRESH_TOKEN_TTL — optional, not secret. Refresh session lifetime in seconds (default 2592000 = 30 days)
REFRESH_TOKEN_TTL=

# OTP_PROVIDER — optional, not secret. development | kavenegar
# Defaults to development when NODE_ENV is development/test; production defaults to kavenegar.
# NODE_ENV=production forbids OTP_PROVIDER=development.
OTP_PROVIDER=

# OTP_HASH_SECRET — required, secret. HMAC key for OTP digests (>= 32 chars, non-trivial)
# Distinct from JWT_ACCESS_SECRET. Never commit real secrets.
OTP_HASH_SECRET=

# CSRF_SECRET — required, secret. Dedicated HMAC key for browser CSRF tokens (>= 32 chars)
CSRF_SECRET=

# CSRF_ALLOWED_ORIGINS — comma-separated canonical browser origins; required in production
CSRF_ALLOWED_ORIGINS=

# OTP_DEV_CODE — optional when OTP_PROVIDER=development. Exactly six digits (default 111111)
# Never enable in production. Do not treat this as a production bypass.
OTP_DEV_CODE=

# OTP_TTL_SECONDS — optional. Challenge lifetime in seconds (default 300, max 900)
OTP_TTL_SECONDS=

# OTP_MAX_ATTEMPTS — optional. Max wrong verifies per challenge (default 5, max 20)
OTP_MAX_ATTEMPTS=

# OTP_RESEND_COOLDOWN_SECONDS — optional. Min seconds between OTP sends per phone (default 60)
OTP_RESEND_COOLDOWN_SECONDS=

# OTP_PHONE_WINDOW_SECONDS / OTP_PHONE_WINDOW_LIMIT — optional phone request window (default 3600 / 5)
OTP_PHONE_WINDOW_SECONDS=
OTP_PHONE_WINDOW_LIMIT=

# OTP_IP_WINDOW_SECONDS / OTP_IP_WINDOW_LIMIT — optional IP request window (default 3600 / 20)
OTP_IP_WINDOW_SECONDS=
OTP_IP_WINDOW_LIMIT=

# OTP_VERIFICATION_GRANT_TTL_SECONDS — optional. Post-verify grant TTL (default 600, max 900)
OTP_VERIFICATION_GRANT_TTL_SECONDS=

# KAVENEGAR_API_KEY — required when OTP_PROVIDER=kavenegar. Secret. Never commit.
KAVENEGAR_API_KEY=

# KAVENEGAR_OTP_TEMPLATE — required when OTP_PROVIDER=kavenegar. Approved verify/lookup template name.
KAVENEGAR_OTP_TEMPLATE=

# STORAGE_PROVIDER — optional, not secret. memory | s3
# Defaults to memory when NODE_ENV is development/test; production defaults to s3.
# NODE_ENV=production forbids STORAGE_PROVIDER=memory. Do not use production buckets in development.
STORAGE_PROVIDER=

# STORAGE_ENDPOINT / STORAGE_REGION / STORAGE_BUCKET — required when STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=

# STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY — required when STORAGE_PROVIDER=s3. Secret. Never commit.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# STORAGE_PUBLIC_BASE_URL — required for s3; optional for memory (default https://media.local.invalid)
# Must be http(s) with a hostname and no embedded credentials. Used to derive Media URLs.
STORAGE_PUBLIC_BASE_URL=

# STORAGE_FORCE_PATH_STYLE — optional. true | false (default true for S3-compatible endpoints)
STORAGE_FORCE_PATH_STYLE=

# MEDIA_MAX_FILE_BYTES — optional. Per-file upload cap in bytes (default 5242880 = 5 MiB, hard max 20 MiB)
MEDIA_MAX_FILE_BYTES=

# MEDIA_MAX_FILES_PER_BATCH — optional. Max files per upload request (default 10, hard max 20)
MEDIA_MAX_FILES_PER_BATCH=

# MEDIA_MAX_BATCH_BYTES — optional. Aggregate batch cap (default 26214400 = 25 MiB, hard max 100 MiB)
MEDIA_MAX_BATCH_BYTES=

# MEDIA_UPLOAD_CONCURRENCY — optional. Internal parallel storage puts (default 3, hard max 8)
MEDIA_UPLOAD_CONCURRENCY=

# ---------------------------------------------------------------------------
# Optional real-infrastructure integration suite (pnpm test:integration*)
# Not used by ordinary pnpm test / pnpm test:e2e. Never point at production.
# See instructions/testing.md and instructions/environment.md.
# ---------------------------------------------------------------------------
# INTEGRATION_TESTS_ENABLED — required for integration commands; must be true
INTEGRATION_TESTS_ENABLED=
# TEST_DATABASE_URL — dedicated disposable integration PostgreSQL
TEST_DATABASE_URL=
# TEST_REDIS_URL — dedicated disposable integration Redis
TEST_REDIS_URL=
# TEST_STORAGE_* — optional dedicated non-production object storage for pnpm test:integration:storage
# Never point at a production bucket.
TEST_STORAGE_ENDPOINT=
TEST_STORAGE_REGION=
TEST_STORAGE_BUCKET=
TEST_STORAGE_ACCESS_KEY=
TEST_STORAGE_SECRET_KEY=
TEST_STORAGE_PUBLIC_BASE_URL=
# INTEGRATION_ALLOW_DESTRUCTIVE — extra opt-in for truncate/reset helpers
INTEGRATION_ALLOW_DESTRUCTIVE=

# ---------------------------------------------------------------------------
# Optional operator Admin bootstrap (pnpm admin:create) — not Nest runtime config
# Never commit values. Never use generic app secrets as the Admin password.
# ---------------------------------------------------------------------------
# EGGSHIP_ADMIN_CREATE_EMAIL
# EGGSHIP_ADMIN_CREATE_PASSWORD
# EGGSHIP_ADMIN_CREATE_ROLE
# EGGSHIP_ADMIN_CREATE_CONFIRM  (development/test: yes; production: I_UNDERSTAND_PRODUCTION:<db-host>)
