{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env*": "deny",
      ".env*": "deny"
    },
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -f*": "deny",
      "git checkout --force*": "deny",
      "git switch -f*": "deny",
      "git switch --force*": "deny",
      "*migrate:deploy*": "deny",
      "*migrate:reset*": "deny",
      "*migrate deploy*": "deny",
      "*migrate reset*": "deny",
      "*db push*": "deny",
      "*redis-cli*": "deny",
      "rm -rf *": "deny"
    }
  }
}
