{
  "name": "eggship-api",
  "version": "0.1.0",
  "description": "Standalone backend API for EggShip.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --entryFile worker --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest --config jest.config.ts --runInBand",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "test:e2e:anl03": "node scripts/run-anl03-e2e.mjs",
    "load:validate": "node scripts/run-load-test.mjs --static-only",
    "load:smoke": "node scripts/run-load-test.mjs smoke",
    "load:browse": "node scripts/run-load-test.mjs browse",
    "load:order-reads": "node scripts/run-load-test.mjs order-reads",
    "load:orders": "node scripts/run-load-test.mjs orders",
    "load:analytics": "node scripts/run-load-test.mjs analytics",
    "test:integration": "node scripts/run-integration-tests.mjs --suite=all",
    "test:integration:postgres": "node scripts/run-integration-tests.mjs --suite=postgres",
    "test:integration:redis": "node scripts/run-integration-tests.mjs --suite=redis",
    "test:integration:storage": "node scripts/run-integration-tests.mjs --suite=storage",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "admin:create": "node scripts/admin-create.mjs",
    "check:agent-tooling": "node scripts/check-agent-tooling.mjs",
    "env:check": "node scripts/check-environment.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test:release": "node --test scripts/lib/release.spec.mjs",
    "openapi:generate": "nest build && node dist/common/openapi/generate-openapi.js",
    "openapi:check": "nest build && node dist/common/openapi/check-openapi.js",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "prisma"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^13.6.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
