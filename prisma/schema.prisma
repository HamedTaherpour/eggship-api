generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Back-office operator role. Values must stay exactly the code-defined `AdminRole`
/// (`src/common/authz/admin-role.ts`). Role → permission policy is code, not data
/// (ADR 0007); this column only records which role an admin holds.
enum AdminRole {
  SUPER_ADMIN
  WAREHOUSE
  ORDER_OPS
}

/// Back-office operator identity. A separate identity and authorization domain from
/// `User`: no shared credential storage, sessions, or permission model.
model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  /// Canonical login email (trimmed, lowercased, ASCII). Identity only — never an
  /// authorization primitive.
  email        String    @unique @db.VarChar(254)
  /// Argon2id digest produced through the `PasswordHasher` port. Never plaintext.
  passwordHash String    @db.VarChar(255)
  role         AdminRole
  /// Prefer deactivation over hard deletion; an inactive admin resolves no permissions.
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions                   AdminAuthSession[]
  commerceSettingsCreated    CommerceSettings[]         @relation("CommerceSettingsCreatedBy")
  commerceSettingsUpdated    CommerceSettings[]         @relation("CommerceSettingsUpdatedBy")
  commerceOverridesCreated   CommerceScheduleOverride[] @relation("CommerceOverrideCreatedBy")
  commerceOverridesUpdated   CommerceScheduleOverride[] @relation("CommerceOverrideUpdatedBy")
  settlementsCreated         OrderSettlement[]          @relation("SettlementCreatedBy")
  settlementsSettled         OrderSettlement[]          @relation("SettlementSettledBy")
  settlementReceiptsAttached OrderSettlement[]          @relation("SettlementReceiptAttachedBy")
}

enum CommerceScheduleOverrideMode {
  CLOSED
  SPECIAL_HOURS
}

/// Singleton, PostgreSQL-authoritative commerce policy (ADR 0016). Wall-clock
/// values are Tehran-local minutes since midnight, never fake UTC timestamps.
model CommerceSettings {
  id                          Int      @id @default(1)
  orderingScheduleEnabled     Boolean
  orderingOpensAtLocalMinute  Int
  orderingClosesAtLocalMinute Int
  minimumOrderQuantity        Int
  revision                    Int
  createdByAdminId            String   @db.Uuid
  updatedByAdminId            String   @db.Uuid
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  createdByAdmin Admin @relation("CommerceSettingsCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedByAdmin Admin @relation("CommerceSettingsUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: Restrict)
}

/// One date-specific Tehran-local schedule override. Absence means fallback;
/// removal is a hard delete coupled to the global settings revision.
model CommerceScheduleOverride {
  id                  String                       @id @default(uuid()) @db.Uuid
  localDate           DateTime                     @unique @db.Date
  mode                CommerceScheduleOverrideMode
  opensAtLocalMinute  Int?
  closesAtLocalMinute Int?
  createdByAdminId    String                       @db.Uuid
  updatedByAdminId    String                       @db.Uuid
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)

  createdByAdmin Admin @relation("CommerceOverrideCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedByAdmin Admin @relation("CommerceOverrideUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: Restrict)

  @@index([localDate])
}

/// Customer/store identity. The authenticated storefront subject is this record.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// Canonical E.164 Iranian mobile, e.g. +989121234567
  phone     String   @unique @db.VarChar(16)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions              AuthSession[]
  orders                Order[]
  notifications         Notification[]
  discountCustomerUsage DiscountCustomerUsage[]
  discountUsageRecords  DiscountUsageRecord[]
  referralAttribution   ReferralAttribution?
}

/// Internal acquisition actor. Deactivation preserves code identity and history.
model Visitor {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(160)
  /// Canonical trimmed uppercase manual-entry-safe code; never reused.
  referralCode String   @unique @db.VarChar(12)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  attributions ReferralAttribution[]

  @@index([isActive, createdAt, id])
}

enum ReferralSource {
  VISITOR
}

/// Immutable registration-time attribution. No update/delete repository API.
/// The source enum leaves room for a future USER source without a polymorphic
/// JSON record; V1 requires VISITOR and the Visitor FK is therefore non-null.
model ReferralAttribution {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @db.Uuid
  source       ReferralSource
  visitorId    String         @db.Uuid
  referralCode String         @db.VarChar(12)
  attributedAt DateTime       @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Restrict)

  @@index([visitorId, attributedAt, id])
  @@index([source, attributedAt, id])
}

/// Durable customer inbox record. This is authoritative independently of push
/// delivery; provider state belongs to a later delivery task.
model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      NotificationType
  source    NotificationSource
  title     String             @db.VarChar(160)
  body      String             @db.VarChar(2000)
  payload   Json
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  readAt    DateTime?          @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Newest-first customer inbox reads.
  @@index([userId, createdAt, id])
  /// Unread filtering/counting followed by newest-first ordering.
  @@index([userId, readAt, createdAt, id])
}

/// Only notification categories with an approved producer are persisted here.
/// New categories are additive enum migrations rather than uncontrolled text.
enum NotificationType {
  ORDER_STATUS
}

/// Provenance of the application operation that created the inbox record.
enum NotificationSource {
  ORDER_TRANSITION
  SYSTEM
}

/// Server-side refresh session for a User only. Admin sessions live on
/// `AdminAuthSession`; `userId` stays non-nullable rather than becoming a
/// nullable polymorphic subject (ADR 0008 / ADR 0009).
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// SHA-256 digest of the current refresh token (base64url, 43 chars). Never store plaintext.
  refreshTokenHash String    @unique @db.VarChar(43)
  /// Stable family id for rotation and reuse detection (UUID).
  tokenFamilyId    String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  /// Null while active; set on logout/revocation (row retained).
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// List/revoke sessions for a user (includes revoked rows for filtering).
  @@index([userId, revokedAt])
  /// Family revocation / reuse detection lookups.
  @@index([tokenFamilyId])
  /// Future expiry cleanup scans.
  @@index([expiresAt])
}

/// Bounded history of consumed User refresh-token digests for reuse detection (AUTH-04).
/// Rows expire for future cleanup; PostgreSQL remains authoritative (not Redis).
/// Admin consumed digests live on `AdminAuthRefreshTokenConsumption` (ADR 0009).
model AuthRefreshTokenConsumption {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  tokenFamilyId    String   @db.Uuid
  /// SHA-256 digest of a previously valid refresh token (base64url, 43 chars).
  refreshTokenHash String   @unique @db.VarChar(43)
  consumedAt       DateTime @db.Timestamptz(3)
  /// Retention bound for later cleanup (aligned with session expiry at consumption time).
  expiresAt        DateTime @db.Timestamptz(3)

  @@index([tokenFamilyId])
  @@index([sessionId])
  @@index([expiresAt])
}

/// Server-side refresh session for an Admin only. Dedicated table rather than a
/// nullable polymorphic subject on `AuthSession` (ADR 0009).
model AdminAuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @db.Uuid
  /// SHA-256 digest of the current refresh token (base64url, 43 chars). Never store plaintext.
  refreshTokenHash String    @unique @db.VarChar(43)
  /// Stable family id for rotation and reuse detection (UUID).
  tokenFamilyId    String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  /// Null while active; set on logout/revocation (row retained).
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  /// List/revoke sessions for an admin (includes revoked rows for filtering).
  @@index([adminId, revokedAt])
  /// Family revocation / reuse detection lookups.
  @@index([tokenFamilyId])
  /// Future expiry cleanup scans.
  @@index([expiresAt])
}

/// Bounded history of consumed Admin refresh-token digests for reuse detection.
/// Separate from `AuthRefreshTokenConsumption` so User consumption cannot
/// reference Admin sessions (ADR 0009). Cleanup later via DATA-02.
model AdminAuthRefreshTokenConsumption {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  tokenFamilyId    String   @db.Uuid
  /// SHA-256 digest of a previously valid refresh token (base64url, 43 chars).
  refreshTokenHash String   @unique @db.VarChar(43)
  consumedAt       DateTime @db.Timestamptz(3)
  /// Retention bound for later cleanup (aligned with session expiry at consumption time).
  expiresAt        DateTime @db.Timestamptz(3)

  @@index([tokenFamilyId])
  @@index([sessionId])
  @@index([expiresAt])
}

/// Product category reference (CAT-02). Flat identity only — no hierarchy in
/// this schema. Legacy field inventory is incomplete (MIG-01); columns are the
/// minimal justified set. Prefer `isActive = false` over hard delete; Product
/// FKs use Restrict (CAT-03).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  /// Display label. Stored trimmed; not unique until MIG-01 evidences uniqueness.
  name      String   @db.VarChar(100)
  /// Public lists return active rows only. Deactivate instead of deleting.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  products  Product[]
  discounts Discount[]

  /// Public active list and Admin filter+name sort.
  @@index([isActive, name])
}

/// Sellable catalog item (CAT-03). Owns identity, Category link, and current
/// selling price in integer Toman. Inventory quantities are not Product fields
/// (INV-01B). Media attachment is later work; CAT-04 owns reusable Media
/// records independently. No SKU/description until
/// MIG-01 evidences them. Prefer `isActive = false` over hard delete.
model Product {
  id         String   @id @default(uuid()) @db.Uuid
  /// Display name / storefront title. Stored trimmed; not unique (MIG-01).
  name       String   @db.VarChar(100)
  /// Current selling price in integer Toman (not Rial). JSON number; PG int4.
  /// Price history is PRC-01; Orders must snapshot this value (ORD-01).
  price      Int
  categoryId String   @db.Uuid
  /// Public APIs return only active products whose Category is also active.
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory             Inventory?
  inventoryReservations InventoryReservation[]
  inventoryLedger       InventoryLedger[]
  orderLines            OrderLine[]
  priceHistory          PriceHistory[]
  discounts             Discount[]

  /// Category filter + active visibility.
  @@index([categoryId, isActive])
  /// Public/admin list by recency when filtered by active.
  @@index([isActive, createdAt])
}

/// Immutable audit row for each actual Product price change (PRC-01).
/// Append-only; no update/delete repository API. `createdAt` is UTC
/// timestamptz — the effective instant of the committed change.
model PriceHistory {
  id        String                @id @default(uuid()) @db.Uuid
  productId String                @db.Uuid
  /// Previous current price in integer Toman (server-read, never client-trusted).
  oldPrice  Int
  /// New current price in integer Toman after the change.
  newPrice  Int
  actorType PriceHistoryActorType
  /// Admin id for actorType ADMIN. Polymorphic; no FK to Admin.
  actorId   String                @db.Uuid
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

enum PriceHistoryActorType {
  ADMIN
}

/// Discount value kind (PRC-02). PERCENT uses `percentValue`; FIXED uses `fixedAmount`.
enum DiscountType {
  PERCENT
  FIXED
}

/// What a discount applies to (PRC-02). Target-specific FK columns enforce scope.
enum DiscountTarget {
  ORDER
  PRODUCT
  CATEGORY
}

/// Admin-managed discount definition (PRC-02). No calculation, redemption, or
/// promo-code semantics here — those belong to PRC-03+ / PRC-04. Prefer
/// `isActive = false` over hard delete; future Order discount snapshots may
/// reference rows. Activation windows are optional UTC timestamptz bounds.
/// Optional `maxQuantityPerCustomer` (DLU-02 / ADR 0017) applies to PRODUCT only.
model Discount {
  id                     String         @id @default(uuid()) @db.Uuid
  /// Admin display label. Stored trimmed.
  name                   String         @db.VarChar(100)
  type                   DiscountType
  target                 DiscountTarget
  /// Whole-number percentage 1–100 when type is PERCENT; null when FIXED.
  percentValue           Int?
  /// Fixed amount in integer Toman when type is FIXED; null when PERCENT.
  fixedAmount            Int?
  /// Required when target is PRODUCT.
  productId              String?        @db.Uuid
  /// Required when target is CATEGORY.
  categoryId             String?        @db.Uuid
  /// Explicit admin lifecycle flag. Deactivate instead of deleting.
  isActive               Boolean        @default(true)
  /// Optional UTC window start. Null means no start bound.
  startsAt               DateTime?      @db.Timestamptz(3)
  /// Optional UTC window end. Null means no end bound.
  endsAt                 DateTime?      @db.Timestamptz(3)
  /// Opaque precedence input for PRC-03 ordering. No stacking/overlap rules here.
  precedence             Int            @default(0)
  /// Optional per-customer lifetime discounted-quantity cap (PRODUCT only; null = unlimited).
  maxQuantityPerCustomer Int?
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  product       Product?                @relation(fields: [productId], references: [id], onDelete: Restrict)
  category      Category?               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customerUsage DiscountCustomerUsage[]
  usageRecords  DiscountUsageRecord[]

  @@index([isActive, createdAt])
  @@index([target, isActive])
  @@index([productId])
  @@index([categoryId])
}

/// Per-(discountId, userId) consumed lifetime discounted quantity (DLU-02 / ADR 0017).
/// PostgreSQL-authoritative; lock FOR UPDATE in sorted discountId order before Inventory.
model DiscountCustomerUsage {
  discountId       String   @db.Uuid
  userId           String   @db.Uuid
  /// Non-negative units already consumed for this pair.
  consumedQuantity Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([discountId, userId])
  @@index([userId, discountId])
}

/// Append-only CONSUME/RELEASE evidence for lifetime discounted quantity (DLU-02).
/// Uniqueness prevents double consume/release per (orderId, discountId, kind).
enum DiscountUsageRecordKind {
  CONSUME
  RELEASE
}

model DiscountUsageRecord {
  id         String                  @id @default(uuid()) @db.Uuid
  discountId String                  @db.Uuid
  userId     String                  @db.Uuid
  /// Opaque order identity (same UUID as Order.id). No cascade delete.
  orderId    String                  @db.Uuid
  kind       DiscountUsageRecordKind
  quantity   Int
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orderId, discountId, kind])
  @@index([discountId, userId, createdAt])
  @@index([orderId])
}

/// Reusable Media library object (CAT-04). Metadata only — binaries live in
/// object storage. Not owned by Product; future Product/Blog/Category FKs
/// must Restrict and must not assume a one-to-one relationship.
model Media {
  id               String   @id @default(uuid()) @db.Uuid
  /// Server-generated object key (`media/<year>/<month>/<uuid>.<ext>`). Unique.
  storageKey       String   @unique @db.VarChar(255)
  /// Client filename metadata only. Never used as a storage path.
  originalFileName String   @db.VarChar(255)
  mimeType         String   @db.VarChar(64)
  /// Byte length of the stored object. int4 is sufficient for launch file caps.
  sizeBytes        Int
  /// Pixel width when reliably parsed from image headers; otherwise null.
  width            Int?
  /// Pixel height when reliably parsed from image headers; otherwise null.
  height           Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  settlementReceipts OrderSettlement[]

  /// Admin library recency and mime filter.
  @@index([createdAt])
  @@index([mimeType, createdAt])
}

/// Public storefront blog post (CNT-01). No Media FK (MED-01 owns attachment).
/// No author, tags, SEO, excerpt, comments, or scheduled publishing. CHECKs live
/// in the SQL migration. Public eligibility is `isPublished = true` only.
model Blog {
  id          String    @id @default(uuid()) @db.Uuid
  /// Canonical public lookup key. Unique across drafts and published posts.
  slug        String    @unique @db.VarChar(120)
  title       String    @db.VarChar(200)
  /// Opaque stored body (HTML or Markdown). Backend does not sanitize or render.
  body        String    @db.Text
  /// Public APIs return only published rows. Drafts never leak via list/detail.
  isPublished Boolean   @default(false)
  /// UTC timestamptz of publication when published. Not a future-schedule gate.
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  /// Public list: published rows ordered by publishedAt with id tie-break.
  @@index([isPublished, publishedAt, id])
}

/// Per-product aggregate sellable balances (INV-01B). `productId` is the natural
/// identity — one Inventory row per Product. `available` is derived, never stored.
/// CHECK constraints live in the SQL migration (`onHand >= 0`, `reserved >= 0`,
/// `reserved <= onHand`). No optimistic `version` column in V1.
model Inventory {
  productId String   @id @db.Uuid
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

/// Per-order reservation row (INV-01B). `orderId` is an opaque domain UUID —
/// Inventory does not FK to Orders; Orders may reference the same UUID.
/// V1 allows one row per (orderId, productId); status transitions ACTIVE → RELEASED | SHIPPED.
enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  SHIPPED
}

model InventoryReservation {
  id        String                     @id @default(uuid()) @db.Uuid
  orderId   String                     @db.Uuid
  productId String                     @db.Uuid
  quantity  Int
  status    InventoryReservationStatus
  createdAt DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                   @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId, status])
}

/// Append-only business stock movement history (INV-01B). Not AuditLog and not
/// the live availability store. No `updatedAt`; application must not update or
/// delete rows. Order-lifecycle uniqueness (one RESERVE/RELEASE/SHIP per
/// ORDER+product) is a partial unique index in the SQL migration.
enum InventoryLedgerType {
  RECEIVE
  ADJUST
  RESERVE
  RELEASE
  SHIP
  RETURN_TO_STOCK
  WRITE_OFF
}

enum InventoryLedgerReferenceType {
  ORDER
  RECEIVE
  ADJUSTMENT
  RETURN
  RECONCILIATION
}

enum InventoryLedgerActorType {
  USER
  ADMIN
  SYSTEM
}

model InventoryLedger {
  id            String                       @id @default(uuid()) @db.Uuid
  productId     String                       @db.Uuid
  type          InventoryLedgerType
  /// Positive magnitude. Direction lives in the delta columns.
  quantity      Int
  onHandDelta   Int
  reservedDelta Int
  onHandAfter   Int
  reservedAfter Int
  referenceType InventoryLedgerReferenceType
  referenceId   String?                      @db.Uuid
  reason        String?                      @db.VarChar(500)
  actorType     InventoryLedgerActorType
  /// Polymorphic; no FK to User/Admin. Null only when actorType is SYSTEM.
  actorId       String?                      @db.Uuid
  correlationId String?                      @db.Uuid
  createdAt     DateTime                     @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

/// Idempotency claims for Admin inventory command mutations (INV-02).
/// One row per caller-provided idempotency key; payload hash detects conflicts.
enum InventoryCommandOperation {
  RECEIVE
  ADJUST
}

enum InventoryCommandIdempotencyStatus {
  PENDING
  COMPLETED
}

model InventoryCommandIdempotency {
  id             String                            @id @default(uuid()) @db.Uuid
  idempotencyKey String                            @unique @db.Uuid
  operation      InventoryCommandOperation
  productId      String                            @db.Uuid
  payloadHash    String                            @db.VarChar(64)
  status         InventoryCommandIdempotencyStatus
  onHandAfter    Int?
  reservedAfter  Int?
  ledgerId       String?                           @db.Uuid
  createdAt      DateTime                          @default(now()) @db.Timestamptz(3)

  @@index([productId, createdAt])
}

/// Geographic/service region reference (CAT-02). No shipping or pricing fields
/// until evidenced. Prefer `isActive = false` over hard delete; future profile
/// or delivery FKs should use Restrict and revisit deletion rules.
model Region {
  id        String   @id @default(uuid()) @db.Uuid
  /// Display label. Stored trimmed; not unique until MIG-01 evidences uniqueness.
  name      String   @db.VarChar(100)
  /// Public lists return active rows only. Deactivate instead of deleting.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  /// Public active list and Admin filter+name sort.
  @@index([isActive, name])
}

/// Customer order lifecycle status (ORD-01). Transition rules belong to ORD-02;
/// inventory quantity effects follow ADR 0012 / `instructions/inventory.md`.
enum OrderStatus {
  PENDING_REVIEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderSettlementStatus {
  OPEN
  SETTLED
}

/// Customer/store order with immutable historical snapshots (ORD-01 / ORD-03).
/// V1 has no online payment gateway — settlement occurs outside EggShip.
/// Prefer User deactivation over hard delete; Orders survive account lifecycle.
model Order {
  id                               String        @id @default(uuid()) @db.Uuid
  userId                           String        @db.Uuid
  status                           OrderStatus   @default(PENDING_REVIEW)
  /// Canonical customer phone at order time (E.164). Immutable after creation.
  customerPhone                    String        @db.VarChar(16)
  /// Region traceability + historical display name. Immutable after creation.
  regionId                         String        @db.Uuid
  regionName                       String        @db.VarChar(100)
  /// Sum of gross line totals in integer Toman (BIGINT — may exceed int4).
  grossSubtotal                    BigInt
  /// Sum of line discount amounts in integer Toman.
  lineDiscountTotal                BigInt
  /// Sum of final line totals after LINE discounts (ORDER discount base).
  subtotalAfterLineDiscounts       BigInt
  /// ORDER-scope discount amount in integer Toman (0 when none applied).
  orderDiscountAmount              BigInt
  /// Payable total after LINE then ORDER composition (ADR 0015).
  total                            BigInt
  /// Shared pricing evaluation instant (PRC-05 evaluatedAt). Immutable.
  pricingEvaluatedAt               DateTime      @db.Timestamptz(3)
  /// Commerce policy revision observed at create (COM-03 / ADR 0016). Immutable.
  commercePolicyRevision           Int?
  /// Applied ORDER discount evidence (null when none). No FK — historical only.
  appliedOrderDiscountId           String?       @db.Uuid
  appliedOrderDiscountName         String?       @db.VarChar(100)
  appliedOrderDiscountType         DiscountType?
  appliedOrderDiscountPercentValue Int?
  appliedOrderDiscountFixedAmount  Int?
  appliedOrderDiscountPrecedence   Int?
  /// Optional HTTP retry identity for ORD-03; immutable when set. Scoped per user.
  idempotencyKey                   String?       @db.Uuid
  /// SHA-256 of normalized create payload for same-key conflict detection.
  idempotencyPayloadHash           String?       @db.VarChar(64)
  /// Scheduled/expected delivery when workflow supports it (ORD-02).
  deliveryAt                       DateTime?     @db.Timestamptz(3)
  confirmedAt                      DateTime?     @db.Timestamptz(3)
  shippedAt                        DateTime?     @db.Timestamptz(3)
  deliveredAt                      DateTime?     @db.Timestamptz(3)
  cancelledAt                      DateTime?     @db.Timestamptz(3)
  /// Human-readable cancellation reason when status is CANCELLED (ORD-05).
  cancelReason                     String?       @db.VarChar(500)
  createdAt                        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime      @updatedAt @db.Timestamptz(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  region     Region           @relation(fields: [regionId], references: [id], onDelete: Restrict)
  lines      OrderLine[]
  settlement OrderSettlement?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Post-delivery deferred-settlement tracking (SET-02 / ADR 0018).
/// Settlement lifecycle is independent from Order fulfillment state and always
/// represents the full immutable Order.total; no amount is duplicated here.
model OrderSettlement {
  id                       String                @id @default(uuid()) @db.Uuid
  orderId                  String                @unique @db.Uuid
  status                   OrderSettlementStatus @default(OPEN)
  dueAt                    DateTime              @db.Timestamptz(3)
  settledAt                DateTime?             @db.Timestamptz(3)
  settledByAdminId         String?               @db.Uuid
  receiptMediaId           String?               @db.Uuid
  receiptAttachedAt        DateTime?             @db.Timestamptz(3)
  receiptAttachedByAdminId String?               @db.Uuid
  createdByAdminId         String                @db.Uuid
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(3)

  order                  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  settledByAdmin         Admin? @relation("SettlementSettledBy", fields: [settledByAdminId], references: [id], onDelete: Restrict)
  receiptMedia           Media? @relation(fields: [receiptMediaId], references: [id], onDelete: Restrict)
  receiptAttachedByAdmin Admin? @relation("SettlementReceiptAttachedBy", fields: [receiptAttachedByAdminId], references: [id], onDelete: Restrict)
  createdByAdmin         Admin  @relation("SettlementCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([dueAt, id])
  @@index([createdAt, id])
  @@index([settledAt, id])
}

/// Immutable order line with product/price/discount snapshots (ORD-01 / ORD-03).
/// Historical display uses snapshot columns, not live Product/Discount fields.
model OrderLine {
  id                              String          @id @default(uuid()) @db.Uuid
  orderId                         String          @db.Uuid
  productId                       String          @db.Uuid
  /// Customer-visible product title at order time. Immutable after creation.
  productName                     String          @db.VarChar(100)
  /// Unit price in integer Toman (int4 — matches Product.price at order time).
  unitPrice                       Int
  quantity                        Int
  /// Units that received the LINE discount (0…quantity). DLU-02 / ADR 0017 snapshot.
  discountedQuantity              Int
  /// Persisted unitPrice × quantity in integer Toman (BIGINT). Server-computed.
  grossLineTotal                  BigInt
  /// LINE-scope discount amount in integer Toman (0 when none applied).
  lineDiscountAmount              BigInt
  /// grossLineTotal − lineDiscountAmount. Server-computed.
  finalLineTotal                  BigInt
  /// Applied LINE discount evidence (null when none). No FK — historical only.
  appliedLineDiscountId           String?         @db.Uuid
  appliedLineDiscountName         String?         @db.VarChar(100)
  appliedLineDiscountType         DiscountType?
  appliedLineDiscountTarget       DiscountTarget?
  appliedLineDiscountPercentValue Int?
  appliedLineDiscountFixedAmount  Int?
  appliedLineDiscountPrecedence   Int?
  appliedLineDiscountProductId    String?         @db.Uuid
  appliedLineDiscountCategoryId   String?         @db.Uuid
  createdAt                       DateTime        @default(now()) @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

/// PostgreSQL-authoritative transactional outbox record (ASY-01). The event
/// intent is inserted by the caller's existing transaction; publication state
/// is advanced later by ASY-02.
model OutboxEvent {
  id             String           @id @db.Uuid
  eventType      String           @db.VarChar(100)
  eventVersion   Int
  correlationId  String           @db.VarChar(128)
  occurredAt     DateTime         @db.Timestamptz(3)
  payload        Json
  state          OutboxEventState @default(PENDING)
  publishedAt    DateTime?
  /// Number of publication attempts, including the current claim.
  attemptCount   Int              @default(0)
  /// Earliest time at which a pending or expired claim may be retried.
  nextAttemptAt  DateTime         @default(now()) @db.Timestamptz(3)
  /// Durable claim identity. It is cleared when the claim is released or published.
  claimToken     String?          @db.Uuid
  claimedAt      DateTime?        @db.Timestamptz(3)
  leaseExpiresAt DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  /// ASY-02 lookup/claim order: pending oldest event, stable UUID tie-break.
  @@index([state, nextAttemptAt, createdAt, id])
  /// DATA-02/ASY-05 cleanup can bound retained published history.
  @@index([publishedAt, id])
}

enum OutboxEventState {
  PENDING
  CLAIMED
  PUBLISHED
}
